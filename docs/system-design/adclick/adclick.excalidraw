      "updated": 1792146402863,
      "created": 1791793234622,
      "link": null,
      "locked": false,
      "text": "UPDATE ticket\nSET status = reserved AND userId = userId\nWHERE id = ticketId AND status = available\n\nUPDATE ticket\nSET status = booked AND userId = userId\nWHERE id = ticketId AND status = reserved\n\nSELECT ...\nFROM ticket\nWHERE status = available\n\nSELECT ...\nFROM ticket\nWHERE status = available OR (status = reserved AND reservedTimestamp < now - TTL)",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "UPDATE ticket\nSET status = reserved AND userId = userId\nWHERE id = ticketId AND status = available\n\nUPDATE ticket\nSET status = booked AND userId = userId\nWHERE id = ticketId AND status = reserved\n\nSELECT ...\nFROM ticket\nWHERE status = available\n\nSELECT ...\nFROM ticket\nWHERE status = available OR (status = reserved AND reservedTimestamp < now - TTL)",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
