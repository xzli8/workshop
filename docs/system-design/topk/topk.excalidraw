      "updated": 1793587495082,
      "link": null,
      "locked": false,
      "text": "view_hour(hour_ts, video_id, views)\n  PK(hour_ts, video_id), no index on views\n  hour_ts = date_trunc('hour', minute_ts)\nview_day / view_month: same, view_total: no time column\n\nINSERT INTO view_hour VALUES (date_trunc('hour', :minute_ts), :vid, :count)\nON CONFLICT (hour_ts, video_id)\nDO UPDATE SET views = view_hour.views + EXCLUDED.views\nRETURNING views",
      "originalText": "view_hour(hour_ts, video_id, views)\n  PK(hour_ts, video_id), no index on views\n  hour_ts = date_trunc('hour', minute_ts)\nview_day / view_month: same, view_total: no time column\n\nINSERT INTO view_hour VALUES (date_trunc('hour', :minute_ts), :vid, :count)\nON CONFLICT (hour_ts, video_id)\nDO UPDATE SET views = view_hour.views + EXCLUDED.views\nRETURNING views",
