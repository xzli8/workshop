      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redis (sorted set)\n\n- time index\nkey: keyword\nvalue: createTimestamp -> postId\n\n- like index\nkey: keyword\nvalue: likeCount -> postId",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
