      "isDeleted": false,
      "boundElements": null,
      "updated": 1791796000668,
      "created": 1791794306246,
      "link": null,
      "locked": false,
      "text": "SET ticket:{ticketId} userId NX EX 600\n\nMGET ticket:{ticketId1} ticket:{} ...\n+\nSELECT ...\nFROM tickets\nWHERE status = available\n\nEXPIRE ticket:{ticketId} 300\n\nlua release\n-- KEYS[1] = ticket:{ticketId}，ARGV[1] = userId\nif redis.call('GET', KEYS[1]) == ARGV[1] then\n  return redis.call('DEL', KEYS[1])\nend\nreturn 0",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SET ticket:{ticketId} userId NX EX 600\n\nMGET ticket:{ticketId1} ticket:{} ...\n+\nSELECT ...\nFROM tickets\nWHERE status = available\n\nEXPIRE ticket:{ticketId} 300\n\nlua release\n-- KEYS[1] = ticket:{ticketId}，ARGV[1] = userId\nif redis.call('GET', KEYS[1]) == ARGV[1] then\n  return redis.call('DEL', KEYS[1])\nend\nreturn 0",
