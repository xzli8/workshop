      "seed": 1919125374,
      "version": 667,
      "versionNonce": 1849804174,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791860143551,
      "created": 1791857027240,
      "link": null,
      "locked": false,
      "text": "NewsFeed\n\nFunctional requirements\n- follow\n- post\n- getNewsFeed\n\nNon-functional requirements\n- availability >> consistency ( < 1 m, eventual consistent)\n- low latency ( <= 200 ms, read >> write)\n- scale ( 10M DAU)\n\nCore entities\n- User\n- Follow\n- Post\n\nAPI\n- POST /users/follow -> 200\nHeader: JWT token | session (userId)\nBody: {\n    followerId\n}\n\n- POST /posts -> 200\nHeader: JWT token | session (userId)\nBody: {\n    content\n}\n\n- GET /feed?pageSize={pageSize}&cursor={cursor(timestamp)}\n{\n    posts: Post[],\n    nextCursor: string\n}\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NewsFeed\n\nFunctional requirements\n- follow\n- post\n- getNewsFeed\n\nNon-functional requirements\n- availability >> consistency ( < 1 m, eventual consistent)\n- low latency ( <= 200 ms, read >> write)\n- scale ( 10M DAU)\n\nCore entities\n- User\n- Follow\n- Post\n\nAPI\n- POST /users/follow -> 200\nHeader: JWT token | session (userId)\nBody: {\n    followerId\n}\n\n- POST /posts -> 200\nHeader: JWT token | session (userId)\nBody: {\n    content\n}\n\n- GET /feed?pageSize={pageSize}&cursor={cursor(timestamp)}\n{\n    posts: Post[],\n    nextCursor: string\n}\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
