    {
      "id": "1NerZZfCLvXDMuZ5bMqP5",
      "type": "text",
      "x": 334.1817321777344,
      "y": 138.51632690429688,
      "width": 615.6394653320312,
      "height": 900,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
